# Copy this file to .env and fill in your own values. Never commit .env itself.

# MongoDB Atlas connection string (free tier is enough for this project).
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/live-auction
MONGODB_URI=mongodb://127.0.0.1:27017/live-auction

# Port the Express server listens on.
PORT=5000
